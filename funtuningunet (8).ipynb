      "source": [
        "# ========== БЛОК 2: УСТАНОВКА БИБЛИОТЕК ==========\n",
        "import subprocess\n",
        "import sys\n",
        "\n",
        "subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"segmentation-models-pytorch\"])\n",
        "\n",
        "# ========== БЛОК 3: СОЗДАНИЕ МОДЕЛИ И БАЗОВЫЙ ИНФЕРЕНС ==========\n",
        "import torch\n",
        "import numpy as np\n",
        "from PIL import Image\n",
        "from torchvision import transforms\n",
        "import matplotlib.pyplot as plt\n",
        "import segmentation_models_pytorch as smp\n",
        "import psutil\n",
        "import random\n",
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "MODEL_PATH = \"unet_resnet34_openearthmap.pth\"\n",
        "\n",
        "def get_ram_usage_mb():\n",
        "    process = psutil.Process(os.getpid())\n",
        "    return process.memory_info().rss / 1024 / 1024\n",
        "\n",
        "def load_image(filepath, target_size=(256, 256)):\n",
        "    img = Image.open(filepath).convert('RGB')\n",
        "    img = img.resize(target_size)\n",
        "    transform = transforms.Compose([\n",
        "        transforms.ToTensor(),\n",
        "        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
        "    ])\n",
        "    img_tensor = transform(img).unsqueeze(0)\n",
        "    return img_tensor, np.array(img)\n",
        "\n",
        "def get_color_mask(pred_mask, num_classes=8):\n",
        "    colors = np.array([\n",
        "        [0, 0, 0], [255, 0, 0], [0, 255, 0], [255, 255, 0],\n",
        "        [0, 0, 255], [255, 0, 255], [0, 255, 255], [255, 255, 255]\n",
        "    ])\n",
        "    h, w = pred_mask.shape\n",
        "    colored = np.zeros((h, w, 3), dtype=np.uint8)\n",
        "    for i in range(num_classes):\n",
        "        colored[pred_mask == i] = colors[i]\n",
        "    return colored\n",
        "\n",
        "def main():\n",
        "    ram_start = get_ram_usage_mb()\n",
        "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "    print(f\"Device: {device}\")\n",
        "\n",
        "    print(\"Загрузка модели U-Net...\")\n",
        "    model = smp.Unet(\n",
        "        encoder_name=\"resnet34\",\n",
        "        encoder_weights=\"imagenet\",\n",
        "        in_channels=3,\n",
        "        classes=8,\n",
        "        activation=None\n",
        "    )\n",
        "    model = model.to(device)\n",
        "    model.eval()\n",
        "\n",
        "    def segment(image_tensor):\n",
        "        with torch.no_grad():\n",
        "            output = model(image_tensor.to(device))\n",
        "            probs = torch.softmax(output, dim=1)\n",
        "            pred = torch.argmax(probs, dim=1)\n",
        "            return pred.squeeze().cpu().numpy(), probs.squeeze().cpu().numpy()\n",
        "\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"РАБОТА С ДАТАСЕТОМ OPENEARTHMAP\")\n",
        "    print(\"=\"*60)\n",
        "\n",
        "\n",
        "    dataset_path = Path(OPENEARTHMAP_PATH)\n",
        "    print(f\"✅ Путь к датасету: {dataset_path}\")\n",
        "\n",
        "    pairs = []\n",
        "\n",
        "    for images_dir in dataset_path.rglob(\"images\"):\n",
        "        labels_dir = images_dir.parent / \"labels\"\n",
        "        if labels_dir.exists():\n",
        "            print(f\"\\n📁 Найдена пара папок:\")\n",
        "            print(f\"   Images: {images_dir}\")\n",
        "            print(f\"   Labels: {labels_dir}\")\n",
        "\n",
        "            for img_file in images_dir.glob(\"*.tif\"):\n",
        "                mask_file = labels_dir / img_file.name\n",
        "                if mask_file.exists():\n",
        "                    pairs.append((img_file, mask_file, images_dir.parent.name))\n",
        "                    print(f\"   ✅ {img_file.name}\")\n",
        "\n",
        "    if len(pairs) == 0:\n",
        "        print(\"\\n❌ НЕ НАЙДЕНО ПАР!\")\n",
        "        return\n",
        "\n",
        "    print(f\"\\n✅ Всего найдено пар: {len(pairs)}\")\n",
        "\n",
        "\n",
        "    random.seed(42)\n",
        "    selected = random.sample(pairs, min(3, len(pairs)))\n",
        "\n",
        "    def load_true_mask(mask_path, target_size=(256, 256)):\n",
        "        mask = Image.open(mask_path)\n",
        "        mask = mask.resize(target_size, Image.NEAREST)\n",
        "        mask_np = np.array(mask)\n",
        "        if len(mask_np.shape) == 3:\n",
        "            mask_np = mask_np[:, :, 0]\n",
        "        if mask_np.max() > 7:\n",
        "            mask_np = (mask_np * 7 / mask_np.max()).astype(np.uint8)\n",
        "        return mask_np\n",
        "\n",
        "    for idx, (img_path, mask_path, region) in enumerate(selected, 1):\n",
        "        print(f\"\\n{'='*50}\")\n",
        "        print(f\"Изображение {idx}: {img_path.name}\")\n",
        "        print(f\"Регион: {region}\")\n",
        "\n",
        "        img_tensor, img_np = load_image(str(img_path))\n",
        "        pred_mask, _ = segment(img_tensor)\n",
        "        true_mask = load_true_mask(str(mask_path))\n",
        "\n",
        "        print(f\"\\n📊 Распределение классов в предсказании:\")\n",
        "        total_pixels = pred_mask.size\n",
        "        for cls in range(8):\n",
        "            count = np.sum(pred_mask == cls)\n",
        "            percent = 100 * count / total_pixels\n",
        "            print(f\"  Класс {cls}: {percent:5.2f}%\")\n",
        "\n",
        "        true_colored = get_color_mask(true_mask)\n",
        "        pred_colored = get_color_mask(pred_mask)\n",
        "\n",
        "        fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
        "        axes[0].imshow(img_np)\n",
        "        axes[0].set_title(f'Оригинал\\n{img_path.name[:30]}')\n",
        "        axes[0].axis('off')\n",
        "        axes[1].imshow(true_colored)\n",
        "        axes[1].set_title(f'Маска из датасета\\n{region}')\n",
        "        axes[1].axis('off')\n",
        "        axes[2].imshow(pred_colored)\n",
        "        axes[2].set_title(f'Маска модели U-Net')\n",
        "        axes[2].axis('off')\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "\n",
        "    ram_end = get_ram_usage_mb()\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(f\"RAM использовано: {ram_end - ram_start:.1f} MB\")\n",
        "    if torch.cuda.is_available():\n",
        "        print(f\"GPU использовано: {torch.cuda.memory_allocated() / 1024 / 1024:.1f} MB\")\n",
        "\n",
        "\n",
        "    torch.save(model.state_dict(), MODEL_PATH)\n",
        "    print(f\"\\n💾 МОДЕЛЬ СОХРАНЕНА: {MODEL_PATH}\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    },
    {
