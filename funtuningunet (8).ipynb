      ],
      "source": [
        "# ========== БЛОК 6: ИНФЕРЕНС ДО ОБУЧЕНИЯ НА UAVid + ДООБУЧИВАНИЕ ==========\n",
        "\n",
        "import torch\n",
        "import numpy as np\n",
        "from PIL import Image\n",
        "from torchvision import transforms\n",
        "import matplotlib.pyplot as plt\n",
        "import segmentation_models_pytorch as smp\n",
        "import os\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import torch.optim as optim\n",
        "import random\n",
        "from pathlib import Path\n",
        "\n",
        "\n",
        "MODEL_PATH = \"unet_resnet34_openearthmap_finetuned.pth\"\n",
        "UAVID_FINETUNED_MODEL_PATH = \"unet_resnet34_uavid_finetuned.pth\"\n",
        "UAVID_PATH = Path(\"/root/.cache/kagglehub/datasets/dasmehdixtr/uavid-v1/versions/3\") # ⚠️ ИЗМЕНИТЕ НА ВАШ ПУТЬ!\n",
        "\n",
        "\n",
        "test_files = [\"0.jpg\", \"1.jpg\", \"2.jpg\", \"3.jpg\"]\n",
        "NUM_PAIRS = 100\n",
        "EPOCHS = 7\n",
        "BATCH_SIZE = 4\n",
        "LEARNING_RATE = 0.0001\n",
        "CLASS_NAMES = ['Clutter', 'Building', 'Road', 'Tree', 'Low veg', 'Static car', 'Moving car', 'Human']\n",
        "\n",
        "\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print(f\"Device: {device}\")\n",
        "\n",
        "\n",
        "def load_image(filepath, target_size=(256, 256)):\n",
        "    img = Image.open(filepath).convert('RGB')\n",
        "    img = img.resize(target_size)\n",
        "    transform = transforms.Compose([\n",
        "        transforms.ToTensor(),\n",
        "        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
        "    ])\n",
        "    img_tensor = transform(img).unsqueeze(0)\n",
        "    return img_tensor, np.array(img)\n",
        "\n",
        "def get_color_mask(pred_mask, num_classes=8):\n",
        "    colors = np.array([\n",
        "        [0, 0, 0], [255, 0, 0], [0, 255, 0], [255, 255, 0],\n",
        "        [0, 0, 255], [255, 0, 255], [0, 255, 255], [255, 255, 255]\n",
        "    ])\n",
        "    h, w = pred_mask.shape\n",
        "    colored = np.zeros((h, w, 3), dtype=np.uint8)\n",
        "    for i in range(num_classes):\n",
        "        colored[pred_mask == i] = colors[i]\n",
        "    return colored\n",
        "\n",
        "def print_class_statistics(mask, class_names):\n",
        "    \"\"\"Выводит процентное соотношение классов\"\"\"\n",
        "    print(f\"\\n📊 ПРОЦЕНТНОЕ СООТНОШЕНИЕ КЛАССОВ:\")\n",
        "    print(\"-\" * 40)\n",
        "    total_pixels = mask.size\n",
        "    for cls, name in enumerate(class_names):\n",
        "        count = np.sum(mask == cls)\n",
        "        percent = 100 * count / total_pixels\n",
        "        bar = \"█\" * int(percent) + \"░\" * (100 - int(percent))\n",
        "        print(f\"  {name:12s}: {percent:5.1f}% {bar}\")\n",
        "\n",
        "def run_inference(model, file, title):\n",
        "    \"\"\"Выполняет инференс на одном файле\"\"\"\n",
        "    if not os.path.exists(file):\n",
        "        print(f\"Файл {file} не найден!\")\n",
        "        return\n",
        "\n",
        "    print(f\"\\n{'='*50}\")\n",
        "    print(f\"Файл: {file}\")\n",
        "\n",
        "    img_tensor, img_np = load_image(file, target_size=(256, 256))\n",
        "\n",
        "    with torch.no_grad():\n",
        "        output = model(img_tensor.to(device))\n",
        "        probs = torch.softmax(output, dim=1)\n",
        "        pred_mask = torch.argmax(probs, dim=1).squeeze().cpu().numpy()\n",
        "\n",
        "    print_class_statistics(pred_mask, CLASS_NAMES)\n",
        "\n",
        "    colored_mask = get_color_mask(pred_mask)\n",
        "\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
        "    axes[0].imshow(img_np)\n",
        "    axes[0].set_title(f'Оригинал: {file}')\n",
        "    axes[0].axis('off')\n",
        "    axes[1].imshow(colored_mask)\n",
        "    axes[1].set_title(title)\n",
        "    axes[1].axis('off')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "class UAVidDataset(Dataset):\n",
        "    def __init__(self, images, masks, target_size=(256,256)):\n",
        "        self.images = images\n",
        "        self.masks = masks\n",
        "        self.target_size = target_size\n",
        "        self.transform = transforms.Compose([\n",
        "            transforms.ToTensor(),\n",
        "            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
        "        ])\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.images)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        img = Image.open(self.images[idx]).convert('RGB').resize(self.target_size)\n",
        "        mask = Image.open(self.masks[idx]).resize(self.target_size, Image.NEAREST)\n",
        "        mask_np = np.array(mask)\n",
        "        if len(mask_np.shape) == 3:\n",
        "            mask_np = mask_np[:,:,0]\n",
        "        if mask_np.max() > 7:\n",
        "            mask_np = (mask_np / (mask_np.max()/7)).astype(np.uint8)\n",
        "        return self.transform(img), torch.from_numpy(mask_np).long()\n",
        "\n",
        "# ========== ОСНОВНОЙ КОД ==========\n",
        "\n",
        "print(f\"📂 Загрузка модели из {MODEL_PATH}...\")\n",
        "if not os.path.exists(MODEL_PATH):\n",
        "    raise FileNotFoundError(f\"Файл {MODEL_PATH} не найден! Сначала выполните блок fine-tuning на OpenEarthMap.\")\n",
        "\n",
        "model = smp.Unet(encoder_name=\"resnet34\", encoder_weights=None, in_channels=3, classes=8)\n",
        "model.load_state_dict(torch.load(MODEL_PATH, map_location=device))\n",
        "model = model.to(device)\n",
        "print(\"✅ Модель загружена\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"ИНФЕРЕНС НА 0.JPEG ... 3.JPEG (ДО ОБУЧЕНИЯ НА UAVid)\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "model.eval()\n",
        "for file in test_files:\n",
        "    run_inference(model, file, 'МАСКА МОДЕЛИ (ДО ОБУЧЕНИЯ НА UAVid)')\n",
        "\n",
        "print(\"\\n✅ ИНФЕРЕНС ДО ОБУЧЕНИЯ ЗАВЕРШЕН\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"ДООБУЧИВАНИЕ МОДЕЛИ НА UAVid\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "\n",
        "if not UAVID_PATH.exists():\n",
        "    print(f\"❌ Путь к датасету не существует: {UAVID_PATH}\")\n",
        "    print(\"Пропускаем дообучивание...\")\n",
        "    do_finetune = False\n",
        "else:\n",
        "    do_finetune = True\n",
        "    all_pairs = []\n",
        "\n",
        "\n",
        "    train_path = UAVID_PATH / \"uavid_train\"\n",
        "    print(f\"\\nИщем в {train_path}\")\n",
        "    if train_path.exists():\n",
        "        for seq_dir in train_path.iterdir():\n",
        "            if seq_dir.is_dir():\n",
        "                img_dir = seq_dir / \"Images\"\n",
        "                lbl_dir = seq_dir / \"Labels\"\n",
        "                if img_dir.exists() and lbl_dir.exists():\n",
        "                    images = list(img_dir.glob(\"*.png\"))\n",
        "                    print(f\"  {seq_dir.name}: {len(images)} изображений\")\n",
        "                    for img in images:\n",
        "                        mask = lbl_dir / img.name\n",
        "                        if mask.exists():\n",
        "                            all_pairs.append((str(img), str(mask)))\n",
        "    else:\n",
        "        print(f\"  ❌ {train_path} не существует!\")\n",
        "\n",
        "    val_path = UAVID_PATH / \"uavid_val\"\n",
        "    print(f\"\\nИщем в {val_path}\")\n",
        "    if val_path.exists():\n",
        "        for seq_dir in val_path.iterdir():\n",
        "            if seq_dir.is_dir():\n",
        "                img_dir = seq_dir / \"Images\"\n",
        "                lbl_dir = seq_dir / \"Labels\"\n",
        "                if img_dir.exists() and lbl_dir.exists():\n",
        "                    images = list(img_dir.glob(\"*.png\"))\n",
        "                    print(f\"  {seq_dir.name}: {len(images)} изображений\")\n",
        "                    for img in images:\n",
        "                        mask = lbl_dir / img.name\n",
        "                        if mask.exists():\n",
        "                            all_pairs.append((str(img), str(mask)))\n",
        "    else:\n",
        "        print(f\"  ❌ {val_path} не существует!\")\n",
        "\n",
        "    print(f\"\\n✅ Всего найдено {len(all_pairs)} пар\")\n",
        "\n",
        "    if len(all_pairs) == 0:\n",
        "        print(\"❌ НЕ НАЙДЕНО ПАР ДЛЯ ДООБУЧИВАНИЯ!\")\n",
        "        do_finetune = False\n",
        "\n",
        "if do_finetune:\n",
        "    random.seed(42)\n",
        "    selected_pairs = random.sample(all_pairs, min(NUM_PAIRS, len(all_pairs)))\n",
        "\n",
        "    random.shuffle(selected_pairs)\n",
        "    split = int(0.8 * len(selected_pairs))\n",
        "    train_pairs, val_pairs = selected_pairs[:split], selected_pairs[split:]\n",
        "\n",
        "    train_loader = DataLoader(UAVidDataset([p[0] for p in train_pairs], [p[1] for p in train_pairs]),\n",
        "                              batch_size=BATCH_SIZE, shuffle=True)\n",
        "    val_loader = DataLoader(UAVidDataset([p[0] for p in val_pairs], [p[1] for p in val_pairs]),\n",
        "                            batch_size=BATCH_SIZE, shuffle=False)\n",
        "\n",
        "\n",
        "    model.train()\n",
        "    optimizer = optim.Adam(model.parameters(), lr=LEARNING_RATE)\n",
        "    criterion = torch.nn.CrossEntropyLoss()\n",
        "\n",
        "    print(f\"\\n=== ДООБУЧИВАНИЕ НА UAVid ({EPOCHS} эпох) ===\\n\")\n",
        "\n",
        "    for epoch in range(EPOCHS):\n",
        "        model.train()\n",
        "        train_loss = 0\n",
        "        for imgs, masks in train_loader:\n",
        "            imgs, masks = imgs.to(device), masks.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            loss = criterion(model(imgs), masks)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            train_loss += loss.item()\n",
        "\n",
        "        model.eval()\n",
        "        val_loss = 0\n",
        "        correct = 0\n",
        "        total = 0\n",
        "        with torch.no_grad():\n",
        "            for imgs, masks in val_loader:\n",
        "                imgs, masks = imgs.to(device), masks.to(device)\n",
        "                outputs = model(imgs)\n",
        "                val_loss += criterion(outputs, masks).item()\n",
        "                _, preds = torch.max(outputs, 1)\n",
        "                correct += (preds == masks).sum().item()\n",
        "                total += masks.numel()\n",
        "\n",
        "        print(f\"Epoch {epoch+1}/{EPOCHS} - Train Loss: {train_loss/len(train_loader):.4f} - Val Loss: {val_loss/len(val_loader):.4f} - Val Acc: {correct/total:.4f}\")\n",
        "\n",
        "    print(\"\\n✅ ДООБУЧИВАНИЕ ЗАВЕРШЕНО\")\n",
        "\n",
